# Trackora frontend — environment
# Copy to .env.local (or .env) for local development.

# Base URL the API client calls. Default is a relative "/api/v1", which the
# Vite dev server proxies to the backend (see vite.config.ts). Keeping it
# relative means the browser stays on one origin, so the httpOnly refresh
# cookie works without any cross-origin CORS/cookie configuration.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api requests. Point this at your running
# Trackora backend. Defaults to http://127.0.0.1:4000 if unset.
# Note: 127.0.0.1 (not "localhost") avoids a Node 18+/Windows quirk where
# "localhost" resolves to IPv6 (::1) first and the proxy logs ECONNREFUSED.
VITE_PROXY_TARGET=http://127.0.0.1:4000
