# Copy to .env and fill in real values before running.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml by default.
DATABASE_URL=postgresql://trackora:trackora@localhost:5432/trackora
DATABASE_POOL_MAX=10

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=eafaa709322e587c3f60d6b35538461c06decf924039318e3d2d4aa371c19dfc
JWT_REFRESH_SECRET=8a466ef5e46d6a4244794068eaa141282beca3d5b29b1ba7346721aaa5003a92
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed frontend origins. Include both
# localhost and 127.0.0.1 variants if you're not sure which one the
# frontend/browser will use — they're different origins for CORS
# purposes even though they're "the same machine".
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
